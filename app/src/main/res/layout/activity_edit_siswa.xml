<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/softBlueLight"
    android:padding="20dp"
    tools:context=".EditSiswaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_blue"
        android:padding="20dp"
        android:elevation="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Data Siswa"
            android:textStyle="bold"
            android:textColor="@color/softBlueDark"
            android:textSize="20sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/InputNisn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="NISN"
            android:textColor="#000000"
            android:inputType="number"
            android:enabled="false"
            android:background="@drawable/edit_teks_bg"
            android:padding="12dp" />

        <EditText
            android:id="@+id/InputNama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Lengkap"
            android:textColor="#000000"
            android:layout_marginTop="12dp"
            android:background="@drawable/edit_teks_bg"
            android:padding="12dp" />

        <EditText
            android:id="@+id/InputTtl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tempat, Tanggal Lahir"
            android:textColor="#000000"
            android:layout_marginTop="12dp"
            android:background="@drawable/edit_teks_bg"
            android:padding="12dp" />

        <EditText
            android:id="@+id/InputJk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Jenis Kelamin"
            android:textColor="#000000"
            android:layout_marginTop="12dp"
            android:background="@drawable/edit_teks_bg"
            android:padding="12dp" />

        <EditText
            android:id="@+id/InputAlamat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Alamat"
            android:textColor="#000000"
            android:layout_marginTop="12dp"
            android:background="@drawable/edit_teks_bg"
            android:padding="12dp" />

        <Button
            android:id="@+id/BtnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ubah"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/softBlue"
            android:layout_marginTop="20dp"
            android:padding="12dp" />
    </LinearLayout>
</ScrollView>
